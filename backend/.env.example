# Groq key (free): https://console.groq.com/keys  Never commit the real .env file.
GROQ_API_KEY=

# Chat model for the interviewer and the debrief, and the speech-to-text model.
# Run `python check_key.py` to check the key and see which models it can use.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo

# Comma-separated list of frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173

# Sessions. Leave empty to keep them in memory (local dev, one long-running server).
# On Vercel (serverless) add Upstash Redis from the Vercel Marketplace; it sets
# KV_REST_API_URL / KV_REST_API_TOKEN for you. Or set these from console.upstash.com:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Protects a public demo from running through your limits.
MAX_SESSIONS_PER_IP_PER_DAY=15

# Speed. How long the model reasons before replying: low | medium | high.
# Interviewer turns are short, so "low" keeps the conversation snappy.
TURN_REASONING=low
REPORT_REASONING=medium
# Give up (and show a retry message) if a reply takes longer than this.
TURN_TIMEOUT_SECONDS=45
TRANSCRIBE_TIMEOUT_SECONDS=40
REPORT_TIMEOUT_SECONDS=150
